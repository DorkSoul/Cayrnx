{
  "name": "cayrnx-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @cayrnx/web build && pnpm --filter cayrnx build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node tools/fixtures/make-fixtures.mjs",
    "lint": "pnpm run typecheck",
    "start": "node apps/server/bin/cayrnx.js",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:reset": "node scripts/dev.mjs --reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
